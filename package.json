{
  "name": "cyberpunk-lore",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first Cyberpunk lore timeline and relevance map for Edgerunners fans. Unofficial fan project.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run validate && npm run layout",
    "build": "next build",
    "start": "npx serve out",
    "lint": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts",
    "layout": "tsx scripts/layout-graph.ts",
    "wiki:fetch": "node scripts/fetch-wiki.mjs",
    "wiki:extract": "node scripts/extract-timeline.mjs",
    "sources": "tsx scripts/sources-log.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.21",
    "d3-force": "^3.0.0",
    "d3-quadtree": "^3.0.1",
    "framer-motion": "^14.4.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/d3-quadtree": "^3.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
